    <div type="titlePage" canonical="false">
      <title type="main">A Hebrew Manuscript of the Book of Revelation</title>
      <title type="sub">British Library, MS Sloane 273</title>
      <title type="sub">Transcribed and Translated by Nehemia Gordon</title>
      <title type="sub">www.NehemiasWall.com</title>
