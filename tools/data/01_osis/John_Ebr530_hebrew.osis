    <div type="book" osisID="John" canonical="true">
        <div type="introduction" canonical="true"><title type="main" canonical="true">הַבְּשׂוֹרָה הַקְּדוֹשָׁה שֶׁל יֵשׁוּעַ הַמַּשִׁיחַ כְּפִי יוֹחָנָן</title></div>
        <title type="chapter" canonical="true">פֶרֶק רִאשׁוֹן</title>
        <chapter sID="John.1" osisID="John.1" n="1"/>
        <verse sID="John.1.1" osisID="John.1.1" n="1"/><milestone type="pb" n="2v"/>בְרֵאשִׁית הָיָה הַדַבָר וְהַדַבָר הַיָה אֵצֶל הַאֱלֹהִים וְהַאֱלֹהִים הוּא הָיָה הַדַבָר<verse eID="John.1.1"/>
        <verse sID="John.1.2" osisID="John.1.2" n="2"/>זֶה הָיָה בְרֵאשִׁית אֵצֶל הַאֱלֹהִים.<verse eID="John.1.2"/>
        <verse sID="John.1.3" osisID="John.1.3" n="3"/>כָל הַדְּבָרִים נֶעֱשֹוּ בוֹ וּמִבִלְעַדָיו לֹא נֶעֱשָֹה דָבַר מִכָל אֲשֶר הָיָה.<verse eID="John.1.3"/>
        <verse sID="John.1.4" osisID="John.1.4" n="4"/>בוֹ הָיוּ הַחַיִים. וְהַחַיִים הַיוּ אוֹר הַאֲנַשִׁים.<verse eID="John.1.4"/>
        <verse sID="John.1.5" osisID="John.1.5" n="5"/>וְהַאוֹר הַיָה זוֹרֵח בַאֲפֵלֹות וְהַאֲפֵלֹות לֹא הֵכִילוּהוּ.<verse eID="John.1.5"/>
        <verse sID="John.1.6" osisID="John.1.6" n="6"/>וַיְהִי אִישׁ אֵחָד שָלוּחַ מֵאֵת הַאֱלֹהִים וּשְמוֹ יוֹחָנָן<verse eID="John.1.6"/>
        <verse sID="John.1.7" osisID="John.1.7" n="7"/>זֶה בָא בְעֵדוּת לְהַעִיד עַל הַאוֹר לְמַעָן אֲשֶר יַאֲמִינוּ הַכָל בַעֲבוּרוֹ.<verse eID="John.1.7"/>
        <verse sID="John.1.8" osisID="John.1.8" n="8"/>הוּא לֹא הָיָה הַאוֹר כִי אִם לְהַעִיד עַל הַאוֹר.<verse eID="John.1.8"/>
        <verse sID="John.1.9" osisID="John.1.9" n="9"/>הָיָה אוֹר אַמִתִּי הַמֵאִיר לְכָל אָדָם הַבָא אֶל הַעוֹלָם הַזֶה.<verse eID="John.1.9"/>
        <verse sID="John.1.10" osisID="John.1.10" n="10"/>הוּא הָיָה בַעוֹלָם וְהַעוֹלָם נֶעֱשָה בוֹ. וְהַעוֹלָם לֹא הִכִירוּהוּ.<verse eID="John.1.10"/>
        <verse sID="John.1.11" osisID="John.1.11" n="11"/>בַא אֶל מוֹלַדְתוֹ מַמָש וּבְנֵי בֵיתוֹ לא קִבְלוּהוּ.<verse eID="John.1.11"/>
        <verse sID="John.1.12" osisID="John.1.12" n="12"/>וּלְכָל אֲשֶר קִבְלוּהוּ וּמַאֲמִינִים בִשְמוֹ נָתַן מֵמְשָלָה שֶיִהְיוּ בְנֵי הַאֱלֹהִים.<verse eID="John.1.12"/>
        <verse sID="John.1.13" osisID="John.1.13" n="13"/>אֲשֶר הֵם לֹא מִדַּם וְלֹא מֵחֵפֶץ הַבָשָׂר וְלֹא מֵחֵפֶץ אָדָם נוֹלָדוּ כִי אִם מֵאֶת האלהים<verse eID="John.1.13"/>
        <chapter eID="John.1"/>
      </div>
  </osisText>
